# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
# Note: tsconfig.tsbuildinfo is excluded from active code but preserved in _nextjs-archive/
next-env.d.ts

# environment variables — NEVER commit these
.env
.env.local
.env.*.local
.neon

# Local Neon migration files
.agents/
backups/
skills-lock.json
supabase-files.txt

# ── Frontend / Backend split (added during restructure) ──

# Frontend build output and dependencies
frontend/node_modules/
frontend/dist/

# Backend dependencies
backend/node_modules/

# Root-level monolithic node_modules (kept for legacy check scripts)
# Remove this entry once check-*.mjs scripts are updated to use backend/node_modules
